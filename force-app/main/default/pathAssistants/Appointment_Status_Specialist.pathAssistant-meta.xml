    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Patient_Email__c</fieldNames>
        <info>&lt;p&gt;The doctor slot is freed and a cancellation email is sent to the patient.&lt;/p&gt;</info>
        <picklistValueName>Cancelled</picklistValueName>
    </pathAssistantSteps>
    <recordTypeName>Specialist_Consultation</recordTypeName>
