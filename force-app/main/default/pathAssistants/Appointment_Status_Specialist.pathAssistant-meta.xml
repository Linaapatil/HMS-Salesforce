    <masterLabel>Appointment Status - Specialist</masterLabel>
    <pathAssistantSteps>
        <fieldNames>Appointment_Date__c</fieldNames>
        <fieldNames>Slot__c</fieldNames>
        <fieldNames>Doctor__c</fieldNames>
        <info>&lt;p&gt;Call the patient to confirm the slot (see the confirmation task).&lt;/p&gt;</info>
        <picklistValueName>Requested</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Patient_Email__c</fieldNames>
        <fieldNames>Appointment_Type__c</fieldNames>
