<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Appointment_Confirmation_Alert</fullName>
        <description>Sent by the Appointment Confirmation flow when Status changes to Confirmed.</description>
        <protected>false</protected>
        <recipients>
            <field>Patient_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>HMS_Email_Templates/Appointment_Confirmation_Template</template>
    </alerts>
    <alerts>
        <fullName>Appointment_Reminder_Alert</fullName>
        <description>Sent by the Daily Morning Reminder scheduled flow for tomorrow's appointments.</description>
        <protected>false</protected>
        <recipients>
            <field>Patient_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>HMS_Email_Templates/Appointment_Reminder_Template</template>
    </alerts>
</Workflow>
