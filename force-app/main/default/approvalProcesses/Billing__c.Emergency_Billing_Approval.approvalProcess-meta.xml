<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Receptionist</submitter>
        <type>roleSubordinates</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Billing_Team</submitter>
        <type>group</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Appointment__c</field>
        <field>Patient__c</field>
        <field>Department_Name__c</field>
        <field>Total_Charges__c</field>
        <field>Insurance_Amount__c</field>
        <field>Amount_Due__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <type>adhoc</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>The submitter selects the Head of the treating department.</description>
        <label>Department Head Approval</label>
        <name>Department_Head_Approval</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>linapatil.sfdc.65f5e75176fb@agentforce.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Bills above Rs. 5,00,000 also need Hospital Admin approval.</description>
        <entryCriteria>
            <criteriaItems>
                <field>Billing__c.Amount_Due__c</field>
                <operation>greaterThan</operation>
                <value>500000</value>
            </criteriaItems>
        </entryCriteria>
        <label>Hospital Admin Approval</label>
        <name>Hospital_Admin_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>Bills over Rs. 1,00,000 must be approved by the Department Head; bills over Rs. 5,00,000 also by the Hospital Admin.</description>
    <emailTemplate>HMS_Email_Templates/Billing_Approved_Template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Billing__c.Amount_Due__c</field>
            <operation>greaterThan</operation>
            <value>100000</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Billing_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Billing_Approved_Alert</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Billing_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Revise_Rejected_Bill</name>
            <type>Task</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Billing_Status_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Emergency Billing Approval</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Billing_Status_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
