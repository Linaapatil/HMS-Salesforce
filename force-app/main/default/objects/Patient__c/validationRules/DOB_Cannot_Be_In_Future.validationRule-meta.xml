<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DOB_Cannot_Be_In_Future</fullName>
    <active>true</active>
    <errorConditionFormula>DOB__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>DOB__c</errorDisplayField>
    <errorMessage>Date of Birth cannot be a future date.</errorMessage>
</ValidationRule>
