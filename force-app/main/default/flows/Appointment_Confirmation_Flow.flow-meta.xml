<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Confirmation_Email</name>
        <label>Send Confirmation Email</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <actionName>Appointment__c.Appointment_Confirmation_Alert</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>Has_Patient</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Has_Patient</name>
        <label>Has Patient</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>No Patient</defaultConnectorLabel>
        <rules>
            <name>Patient_Linked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Patient__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Last_Appointment_Date</targetReference>
            </connector>
            <label>Patient Linked</label>
        </rules>
