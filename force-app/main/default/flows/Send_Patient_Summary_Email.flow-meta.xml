<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Summary_Email</name>
        <label>Send Summary Email</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Email_Sent</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Recipient_Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Your MedCare patient summary</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ttSummary</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>relatedRecordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <description>Quick action on Patient: emails the patient a summary of their record.</description>
    <environments>Default</environments>
    <interviewLabel>Send Patient Summary Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Patient Summary Email</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Patient</name>
        <label>Get Patient</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Preview</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Patient__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Full_Name__c</queriedFields>
        <queriedFields>Email__c</queriedFields>
        <queriedFields>Blood_Group__c</queriedFields>
        <queriedFields>Age__c</queriedFields>
        <queriedFields>Total_Appointments__c</queriedFields>
        <queriedFields>Last_Appointment_Date__c</queriedFields>
        <queriedFields>Total_Billed_Amount__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Email_Sent</name>
        <label>Email Sent</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Sent_Message</name>
            <fieldText>&lt;p&gt;Summary emailed to &lt;b&gt;{!Recipient_Email}&lt;/b&gt;.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Preview</name>
        <label>Preview</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Send_Summary_Email</targetReference>
        </connector>
        <fields>
            <name>Recipient_Email</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Get_Patient.Email__c</elementReference>
            </defaultValue>
            <fieldText>Send to</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Preview_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Preview&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!ttSummary}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Patient</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ttSummary</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Dear {!Get_Patient.Full_Name__c},

Here is your MedCare Hospital summary.

Patient ID: {!Get_Patient.Name}
Blood Group: {!Get_Patient.Blood_Group__c}
Age: {!Get_Patient.Age__c}
Total Appointments: {!Get_Patient.Total_Appointments__c}
Last Appointment: {!Get_Patient.Last_Appointment_Date__c}
Total Billed: {!Get_Patient.Total_Billed_Amount__c}

Regards,
MedCare Hospital</text>
    </textTemplates>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
