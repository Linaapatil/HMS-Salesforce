<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Doctor Schedule Card</masterLabel>
    <description>Doctor portal: a doctor's daily schedule and patient list.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="cardTitle" type="String" default="Today's Schedule" label="Card title"/>
            <objects>
                <object>Doctor__c</object>
            </objects>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="cardTitle" type="String" default="My Schedule" label="Card title"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
