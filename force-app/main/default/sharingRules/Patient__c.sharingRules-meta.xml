<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Share_General_Medicine_Patients</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share General Medicine patients with doctors of the same department.</description>
        <label>Share General Medicine Patients</label>
        <sharedTo>
            <group>Dept_General_Medicine_Doctors</group>
        </sharedTo>
        <criteriaItems>
            <field>Primary_Department__c</field>
            <operation>equals</operation>
            <value>General Medicine</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
